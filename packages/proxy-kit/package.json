{
  "name": "@gian/proxy-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared gian.proxy/2 wire server for Gian Proxies: framing, JSON-RPC, notification ordering, dispatch lanes and process lifecycle",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm run clean && tsc",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@gian/proxy-protocol": "https://github.com/RichToyo/Gian/releases/download/proxy-protocol-v1.0.5/gian-proxy-protocol-1.0.5.tgz"
  }
}
